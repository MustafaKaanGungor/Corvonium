{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "suspicious": "warn",
    "perf": "warn"
  },
  "rules": {
    "no-underscore-dangle": ["warn", { "allow": ["_deleted"] }]
  },
  "ignorePatterns": ["dist", "design", "node_modules"]
}
